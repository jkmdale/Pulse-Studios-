{
  "name": "Pulse Heirloom Order Pipeline",
  "nodes": [
    {
      "parameters": {
        "topic": "orders/create",
        "options": {}
      },
      "name": "Shopify Order Created",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "pulse-heirloom-orders"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.note_attributes ? $json.note_attributes.find(a => a.name.toLowerCase().includes('audio') || a.name.toLowerCase().includes('file'))?.value : '' }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Has Audio Attachment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PYTHON_API_URL }}/webhook/shopify",
        "authentication": "none",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Shopify-Hmac-Sha256",
              "value": "={{ $env.SHOPIFY_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "name": "Trigger Processing API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 90,
        "unit": "seconds"
      },
      "name": "Wait for Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [900, 220]
    },
    {
      "parameters": {
        "url": "={{ $env.PYTHON_API_URL }}/api/order/{{ $node['Shopify Order Created'].json.id }}",
        "method": "GET",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Check Pipeline Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "complete"
            }
          ]
        }
      },
      "name": "Pipeline Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "fromEmail": "hello@pulseheirloom.com",
        "toEmail": "={{ $node['Shopify Order Created'].json.email }}",
        "subject": "Your Pulse & Heirloom order is being crafted ❤️",
        "text": "Hi {{ $node['Shopify Order Created'].json.customer?.first_name || 'there' }},\n\nWe've received your audio and your custom heartbeat print is being prepared now.\n\nYou can scan the QR code on your framed print when it arrives to hear the lullaby and feel the heartbeat pulse on your phone.\n\nWe'll email your tracking information as soon as your print ships.\n\nWith love,\nPulse & Heirloom Studios",
        "options": {}
      },
      "name": "Email Customer — Success",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1560, 160]
    },
    {
      "parameters": {
        "channel": "#alerts",
        "text": "🚨 Pipeline FAILED for Shopify order {{ $node['Shopify Order Created'].json.id }}\nCustomer: {{ $node['Shopify Order Created'].json.email }}\nError: {{ $node['Check Pipeline Status'].json.error || 'Unknown' }}\n\nCheck CloudWatch logs for order {{ $node['Shopify Order Created'].json.id }}.",
        "otherOptions": {}
      },
      "name": "Alert — Pipeline Failed",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1560, 340]
    },
    {
      "parameters": {
        "channel": "#alerts",
        "text": "⚠️ Shopify order {{ $json.id }} received but has NO audio attachment.\nCustomer: {{ $json.email }}\n\nManually follow up to collect audio file.",
        "otherOptions": {}
      },
      "name": "Alert — No Audio",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [680, 400]
    }
  ],
  "connections": {
    "Shopify Order Created": {
      "main": [
        [{"node": "Has Audio Attachment?", "type": "main", "index": 0}]
      ]
    },
    "Has Audio Attachment?": {
      "main": [
        [{"node": "Trigger Processing API", "type": "main", "index": 0}],
        [{"node": "Alert — No Audio", "type": "main", "index": 0}]
      ]
    },
    "Trigger Processing API": {
      "main": [
        [{"node": "Wait for Processing", "type": "main", "index": 0}]
      ]
    },
    "Wait for Processing": {
      "main": [
        [{"node": "Check Pipeline Status", "type": "main", "index": 0}]
      ]
    },
    "Check Pipeline Status": {
      "main": [
        [{"node": "Pipeline Succeeded?", "type": "main", "index": 0}]
      ]
    },
    "Pipeline Succeeded?": {
      "main": [
        [{"node": "Email Customer — Success", "type": "main", "index": 0}],
        [{"node": "Alert — Pipeline Failed", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["pulse-heirloom", "fulfillment"],
  "meta": {
    "templateId": "pulse-heirloom-v1"
  }
}
