# AWS S3 — file storage backbone for audio, PDFs, metadata
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=pulse-heirloom-orders

# Shopify — webhook verification and order management
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Gelato — print fulfillment API
# Get GELATO_PRODUCT_UID from your Gelato merchant dashboard after configuring
# the 12"x16" wall art product. This is NOT an invented value.
GELATO_API_KEY=
GELATO_PRODUCT_UID=

# Application
BASE_URL=https://your-domain.com
ENVIRONMENT=development
PORT=8000

# Redis — Celery task broker (use redis://redis:6379/0 in Docker)
REDIS_URL=redis://redis:6379/0
